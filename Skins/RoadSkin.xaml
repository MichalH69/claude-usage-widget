<UserControl x:Class="ClaudeUsageWidget.Skins.RoadSkin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:ClaudeUsageWidget.Skins"
             Width="312" Height="266" FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Glossy black plastic of the hood and the base, as on the aquarium. -->
        <LinearGradientBrush x:Key="Plastic" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5A636B" Offset="0" />
            <GradientStop Color="#272C31" Offset="0.46" />
            <GradientStop Color="#090B0D" Offset="0.5" />
            <GradientStop Color="#1A1E22" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Asphalt" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4E555B" Offset="0" />
            <GradientStop Color="#3A4045" Offset="0.45" />
            <GradientStop Color="#2A2E32" Offset="1" />
        </LinearGradientBrush>

        <!-- One lane: the road, with its sign on posts above it and its traffic on it. Placed by Canvas.Top. -->
        <Style x:Key="Road" TargetType="Rectangle">
            <Setter Property="Width" Value="302" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Fill" Value="{StaticResource Asphalt}" />
        </Style>
        <Style x:Key="Kerb" TargetType="Rectangle">
            <Setter Property="Width" Value="302" />
            <Setter Property="Height" Value="1.6" />
            <Setter Property="Fill" Value="#D8E2E8" />
        </Style>
    </UserControl.Resources>

    <Canvas>
        <!-- Shadow on whatever the widget stands on. -->
        <Ellipse Canvas.Left="8" Canvas.Top="246" Width="296" Height="16" Fill="Black" Opacity="0.55">
            <Ellipse.Effect>
                <BlurEffect Radius="12" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- The view. -->
        <Canvas Canvas.Left="5" Canvas.Top="22" Width="302" Height="226">
            <Canvas.Clip>
                <RectangleGeometry Rect="0,0,302,226" RadiusX="4" RadiusY="4" />
            </Canvas.Clip>

            <!-- Sky, a low sun and two clouds. -->
            <Rectangle Width="302" Height="60">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#5DB8F0" Offset="0" />
                        <GradientStop Color="#A8DDF8" Offset="0.6" />
                        <GradientStop Color="#E6F6FC" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse Canvas.Left="196" Canvas.Top="-40" Width="130" Height="100">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#C0FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path Fill="#D8FFFFFF" Data="M 30,22 C 30,15 40,13 45,17 C 48,10 60,10 63,17 C 70,15 76,19 74,24 C 74,27 70,28 66,28 L 34,28 C 30,28 28,25 30,22 Z" />
            <Path Fill="#B8FFFFFF" Data="M 150,16 C 150,11 158,10 161,13 C 164,8 173,9 175,14 C 180,13 184,16 182,20 L 152,20 C 149,20 148,18 150,16 Z" />

            <!-- Hills, the far ones paler. -->
            <Path Fill="#9CCF7E" Data="M 0,46 C 30,32 64,30 104,40 C 140,30 186,26 222,38 C 252,30 280,32 302,38 L 302,52 L 0,52 Z" />
            <Path Fill="#6FBA52" Data="M 0,50 C 40,40 90,42 130,47 C 170,40 230,40 302,46 L 302,56 L 0,56 Z" />

            <!-- The far motorway with its traffic, and the crash barrier in front of it. -->
            <Rectangle Canvas.Top="44" Width="302" Height="12" Fill="#8C979E" />
            <Rectangle Canvas.Top="44" Width="302" Height="0.8" Fill="#D0FFFFFF" />
            <Rectangle Canvas.Top="50" Width="302" Height="0.6" Fill="#80FFFFFF" />
            <s:BackgroundTraffic x:Name="Traffic" Width="302" Height="60" Opacity="0.7" />
            <Rectangle Canvas.Top="44" Width="302" Height="12" Fill="#28C8E6F4" IsHitTestVisible="False" />
            <Rectangle Canvas.Top="55.5" Width="302" Height="2.4">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2F6F8" Offset="0" />
                        <GradientStop Color="#8E989F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Grass along the roads. -->
            <Rectangle Canvas.Top="57.9" Width="302" Height="170">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7CC657" Offset="0" />
                        <GradientStop Color="#4FA33A" Offset="0.55" />
                        <GradientStop Color="#2F7A28" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- The three lanes. Each is 55 units tall: the sign at the top, the road from 30 to 50. -->
            <Canvas x:Name="Lanes">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Style.Triggers>
                            <!-- Old values stay readable but step back. -->
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>

                <Canvas Canvas.Top="60" DataContext="{Binding Session}">
                    <Rectangle Style="{StaticResource Kerb}" Canvas.Top="29" />
                    <Rectangle Style="{StaticResource Road}" Canvas.Top="30.4" />
                    <Rectangle Style="{StaticResource Kerb}" Canvas.Top="52.4" />
                    <s:RoadSign x:Name="SessionSign" Canvas.Left="44" Canvas.Top="1" Label="SESSION · 5 H"
                                PercentText="{Binding PercentText}" Level="{Binding Level}" Countdown="{Binding Countdown}"
                                ResetText="{Binding ResetText}" ResetClock="{Binding ResetClock}" TimeLeft="{Binding TimeLeft}" />
                    <s:TrafficLane x:Name="SessionLane" Width="302" Height="55" Seed="1" Fleet="Mix" Value="{Binding Percent}" />
                </Canvas>

                <Canvas Canvas.Top="115" DataContext="{Binding Weekly}">
                    <Rectangle Style="{StaticResource Kerb}" Canvas.Top="29" />
                    <Rectangle Style="{StaticResource Road}" Canvas.Top="30.4" />
                    <Rectangle Style="{StaticResource Kerb}" Canvas.Top="52.4" />
                    <s:RoadSign x:Name="WeeklySign" Canvas.Left="44" Canvas.Top="1" Label="TÝDEN"
                                PercentText="{Binding PercentText}" Level="{Binding Level}" Countdown="{Binding Countdown}"
                                ResetText="{Binding ResetText}" ResetClock="{Binding ResetClock}" TimeLeft="{Binding TimeLeft}" />
                    <s:TrafficLane x:Name="WeeklyLane" Width="302" Height="55" Seed="2" Fleet="Campers" Value="{Binding Percent}" />
                </Canvas>

                <Canvas Canvas.Top="170" DataContext="{Binding Fable}">
                    <Rectangle Style="{StaticResource Kerb}" Canvas.Top="29" />
                    <Rectangle Style="{StaticResource Road}" Canvas.Top="30.4" />
                    <Rectangle Style="{StaticResource Kerb}" Canvas.Top="52.4" />
                    <s:RoadSign x:Name="FableSign" Canvas.Left="44" Canvas.Top="1" Label="FABLE"
                                PercentText="{Binding PercentText}" Level="{Binding Level}" Countdown="{Binding Countdown}"
                                ResetText="{Binding ResetText}" ResetClock="{Binding ResetClock}" TimeLeft="{Binding TimeLeft}" />
                    <s:TrafficLane x:Name="FableLane" Width="302" Height="55" Seed="3" Fleet="Racers" Value="{Binding Percent}" />
                </Canvas>
            </Canvas>

            <!-- Glass over the view. -->
            <Polygon Points="186,0 236,0 150,226 100,226" Fill="#0AFFFFFF" IsHitTestVisible="False" />
            <Rectangle Width="302" Height="226" RadiusX="4" RadiusY="4" Stroke="#B0E9FBFF" StrokeThickness="1.6" />
            <Rectangle Width="302" Height="226" RadiusX="4" RadiusY="4" Stroke="#80000000" StrokeThickness="0.8" />
        </Canvas>

        <!-- Hood. -->
        <Border Width="312" Height="27" CornerRadius="9,9,3,3" Background="{StaticResource Plastic}" BorderBrush="#F0000000" BorderThickness="1">
            <Grid>
                <Border CornerRadius="8,8,0,0" BorderBrush="#66FFFFFF" BorderThickness="0,1,0,0" Margin="1,0,1,0" />
                <Ellipse Width="10" Height="10" HorizontalAlignment="Left" Margin="10,0,0,0" Stroke="#C0001A2E" StrokeThickness="0.8">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#7CF09A" Offset="0.45" />
                            <GradientStop Color="#16A048" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#5CF08A" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="Využití Claude" FontSize="12" FontWeight="SemiBold" Foreground="#EAF4FA" Margin="46,0,0,1" VerticalAlignment="Center" />
                <TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="#9DB3C1" Margin="0,0,11,1" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Base. -->
        <Border Canvas.Top="245" Width="312" Height="11" CornerRadius="2,2,6,6" Background="{StaticResource Plastic}" BorderBrush="#F0000000" BorderThickness="1" />
    </Canvas>
</UserControl>
